digraph {

    graph [fontname = "helvetica" rankdir="TB" ranksep=0.75 nodesep=0.5];
    node [fontname = "helvetica" shape = "box" width=2.5 height=1 style=filled];
    edge [fontname = "helvetica" penwidth=3 color="#000000"];

  subgraph cluster_END {
  label="END"
  bgcolor="#007154"
  fontcolor="#FFFFFF"
    n4 [label=< <TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0">
    <TR>
        <TD COLSPAN="2"><FONT POINT-SIZE="10">n4</FONT>: end</TD>
    </TR>
    
        
           <TR>
<TD BGCOLOR="#F597CB">cost=1</TD>
</TR>
        
           <TR>
<TD BGCOLOR="#68C7FF">t=1 day</TD>
</TR>
        
    
   </TABLE>
> fillcolor="#FFFFFF"]
  }
  subgraph cluster_FAST {
  label="FAST"
  bgcolor="#007154"
  fontcolor="#FFFFFF"
    n2 [label=< <TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0">
    <TR>
        <TD COLSPAN="2"><FONT POINT-SIZE="10">n2</FONT>: rapid but hard</TD>
    </TR>
    
        
           <TR>
<TD BGCOLOR="#F597CB">cost=9</TD>
</TR>
        
           <TR>
<TD BGCOLOR="#68C7FF">t=10 minutes</TD>
</TR>
        
    
   </TABLE>
> fillcolor="#FFFFFF"]
    n3 [label=< <TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0">
    <TR>
        <TD COLSPAN="2"><FONT POINT-SIZE="10">n3</FONT>: rapid and easy</TD>
    </TR>
    
        
           <TR>
<TD BGCOLOR="#F597CB">cost=1</TD>
</TR>
        
           <TR>
<TD BGCOLOR="#68C7FF">t=10 minutes</TD>
</TR>
        
    
   </TABLE>
> fillcolor="#FFFFFF"]
  }
  subgraph cluster_INIT {
  label="INIT"
  bgcolor="#666728"
  fontcolor="#FFFFFF"
    n0 [label=< <TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0">
    <TR>
        <TD COLSPAN="2"><FONT POINT-SIZE="10">n0</FONT>: init project</TD>
    </TR>
    
        
           <TR>
<TD BGCOLOR="#F597CB">cost=5</TD>
</TR>
        
           <TR>
<TD BGCOLOR="#68C7FF">t=1 day</TD>
</TR>
        
    
   </TABLE>
> fillcolor="#FFFFFF"]
    n1 [label=< <TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0">
    <TR>
        <TD COLSPAN="2"><FONT POINT-SIZE="10">n1</FONT>: quick next step</TD>
    </TR>
    
        
           <TR>
<TD BGCOLOR="#F597CB">cost=1</TD>
</TR>
        
           <TR>
<TD BGCOLOR="#68C7FF">t=10 minutes</TD>
</TR>
        
    
   </TABLE>
> fillcolor="#FFFFFF"]
  }
  subgraph cluster_SLOW {
  label="SLOW"
  bgcolor="#E3003D"
  fontcolor="#FFFFFF"
    n5 [label=< <TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0">
    <TR>
        <TD COLSPAN="2"><FONT POINT-SIZE="10">n5</FONT>: slow and easy</TD>
    </TR>
    
        
           <TR>
<TD BGCOLOR="#F597CB">cost=1</TD>
</TR>
        
           <TR>
<TD BGCOLOR="#68C7FF">t=1 day</TD>
</TR>
        
    
   </TABLE>
> fillcolor="#FFFFFF"]
  }

    "n0" -> "n1" [label="e0"];
    "n1" -> "n2" [label="e1"];
    "n2" -> "n3" [label="e2"];
    "n3" -> "n4" [label="e3"];
    "n1" -> "n5" [label="e4"];
    "n5" -> "n4" [label="e5"];

}